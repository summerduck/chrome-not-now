{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.1.0",
  "description": "Blocks distracting sites during focus hours.",
  "permissions": ["declarativeNetRequest", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
